# At least one on-chain provider is required.
# ALCHEMY_API_KEY enables multi-chain (EVM RPC + Prices API + Solana RPC).
ALCHEMY_API_KEY=
# Optional: Solana holder census + bounded 30-day Smart Money flow (free tier).
# When set WITHOUT ALCHEMY_API_KEY, it also serves as the Solana RPC provider.
HELIUS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEFAULT_CHAIN=solana
API_PORT=3000
# Worker cadence for periodic monitoring of the watchlist (minutes).
WATCHLIST_OBSERVATION_INTERVAL_MINUTES=60
# Set true to run one monitoring cycle immediately on worker startup.
RUN_MONITOR_ON_START=false