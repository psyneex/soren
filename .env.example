# Local environment for the smoke test and e2e scripts
# (npx tsx --env-file .env src/monitor/smoke.ts).
#
# The Cloudflare Worker itself does NOT read this file — it gets its config
# from `wrangler.jsonc` vars and from production secrets set via
# `wrangler secret put`. See README.md "Cloudflare deployment".

# At least one on-chain provider is required.
# ALCHEMY_API_KEY enables multi-chain (EVM RPC + Prices API + Solana RPC).
ALCHEMY_API_KEY=
# Optional: Solana holder census + bounded 30-day Smart Money flow (free tier).
# When set WITHOUT ALCHEMY_API_KEY, it also serves as the Solana RPC provider.
HELIUS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEFAULT_CHAIN=solana